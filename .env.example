# Public runtime/build variables. Set these in the deployment environment before `next build`.
NEXT_PUBLIC_SITE_URL=https://your-domain.example
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server-only. Never expose, log, or commit these values.
SUPABASE_SERVICE_ROLE_KEY=replace_me
CART_COOKIE_SECRET=replace_with_a_32_byte_or_longer_random_secret

# Wompi Colombia. Use sandbox credentials until the production launch is approved.
NEXT_PUBLIC_WOMPI_PUBLIC_KEY=pub_test_replace_me
WOMPI_INTEGRITY_SECRET=replace_me
WOMPI_EVENTS_SECRET=replace_me
WOMPI_PRIVATE_KEY=prv_test_replace_me
WOMPI_ENVIRONMENT=sandbox

# Authorizes the reservation-expiry job only.
CRON_SECRET=replace_with_a_different_32_byte_or_longer_random_secret
